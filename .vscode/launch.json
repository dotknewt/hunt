{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug hunt config creation",
      "type": "debugpy",
      "request": "launch",
      "module": "hunt",
      "args": [
        "init",
        "--vault-path",
        "$HOME/Downloads/hunt-debug-vault",
        "--vault-branch",
        "drafting",
        "--yes"
      ],
      "cwd": "$HOME/Code/hunt",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal"
    }
  ]
}
